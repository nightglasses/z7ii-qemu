# Native Meson patch_directory overlays belong to the configured source graph.
# The downloaded provider stays intact; only its managed overlay links change.
file(GLOB wraps CONFIGURE_DEPENDS "${QEMU_UPSTREAM}/subprojects/*.wrap")
foreach(wrap IN LISTS wraps)
  get_filename_component(directory "${wrap}" NAME_WE)
  set(patch_directory "")
  file(STRINGS "${wrap}" settings REGEX "^(directory|patch_directory)[ \t]*=")
  foreach(setting IN LISTS settings)
    if(setting MATCHES "^directory[ \t]*=[ \t]*(.+)$")
      string(STRIP "${CMAKE_MATCH_1}" directory)
    elseif(setting MATCHES "^patch_directory[ \t]*=[ \t]*(.+)$")
      string(STRIP "${CMAKE_MATCH_1}" patch_directory)
    endif()
  endforeach()
  set(download "${QEMU_VIEW}/subprojects/${directory}")
  if(patch_directory STREQUAL "" OR NOT IS_DIRECTORY "${download}")
    continue()
  endif()

  # Discard dangling generated packagefiles entries, never provider sources.
  file(GLOB_RECURSE entries LIST_DIRECTORIES false "${download}/*")
  foreach(entry IN LISTS entries)
    if(IS_SYMLINK "${entry}" AND NOT EXISTS "${entry}")
      file(READ_SYMLINK "${entry}" target)
      string(FIND "${target}" "/subprojects/packagefiles/" overlay)
      if(NOT overlay EQUAL -1)
        file(REMOVE "${entry}")
      endif()
    endif()
  endforeach()

  set(packagefiles "${QEMU_UPSTREAM}/subprojects/packagefiles/${patch_directory}")
  file(GLOB_RECURSE sources CONFIGURE_DEPENDS LIST_DIRECTORIES false
    RELATIVE "${packagefiles}" "${packagefiles}/*")
  foreach(path IN LISTS sources)
    get_filename_component(parent "${download}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    native_link("${packagefiles}/${path}" "${download}/${path}")
  endforeach()
endforeach()
