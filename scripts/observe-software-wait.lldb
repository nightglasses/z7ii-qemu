# Source: RTOS 17f765d38903ec156b89ae9cf74abc9bc56c5a29.
# Load only AFTER connecting to the stopped QEMU GDB stub in a fresh target.
# No launch, connection, initial continue, target write, step or Python here.
# Every callback stops on error and reaches continue only after its reads succeed.
settings set target.require-hardware-breakpoint true
settings set target.skip-prologue false
settings set stop-disassembly-count 0
expression --allow-jit false -- unsigned int $ng_task = 0
expression --allow-jit false -- unsigned int $ng_cb = 0
expression --allow-jit false -- unsigned int $ng_id = 0
expression --allow-jit false -- unsigned int $ng_pid = 0

# The one known output ID word can be created before the business marker.
breakpoint set -H -o true -a 0x10360ed8 -N ng_creator -c '$r4 == 0xb18094e0'
breakpoint command add -s command -e true
thread info
register read -f x r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 sp lr pc cpsr MPIDR_EL1
memory read -f x -s 4 -c 1 0xb18094e0
continue
DONE

# Generic first wait of the actual task, without assuming a mutex service.
breakpoint set -H -o true -d -a 0x10120908 -N ng_make_wait -c '$ng_task != 0 && ($MPIDR_EL1 & 3) < 2 && *(unsigned int *)(0xb2b415f4 + 4 * ($MPIDR_EL1 & 3)) == $ng_task'
breakpoint command add -s command -e true
thread info
register read -f x r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 sp lr pc cpsr MPIDR_EL1
memory read -f x -s 4 -c 2 0xb2b415f4
expression --allow-jit false -f x -- *(unsigned char *)($ng_task + 0x2b)
expression --allow-jit false -f x -- *(unsigned int *)($ng_task + 0x30)
expression --allow-jit false -f x -- *(unsigned int *)($ng_task + 0x34)
expression --allow-jit false -f x -- *(unsigned int *)($ng_task + 0x40)
continue
DONE

# This native mutex branch is BEFORE the TCB wait fields are written.
breakpoint set -H -o true -d -a 0x1010fdd4 -N ng_mutex_block -c '$ng_task != 0 && $r1 == $ng_task && $r4 != 0 && ($r4 & 3) == 0'
breakpoint command add -s command -e true
thread info
register read -f x r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 sp lr pc cpsr MPIDR_EL1
expression --allow-jit false -- $ng_cb = (unsigned int)$r4
expression --allow-jit false -f x -- *(unsigned int *)($ng_cb + 0)
expression --allow-jit false -f x -- *(unsigned int *)($ng_cb + 4)
expression --allow-jit false -f x -- $ng_id = *(unsigned int *)($ng_cb + 8)
expression --allow-jit false -f x -- *(unsigned int *)($ng_cb + 0x10)
expression --allow-jit false -f x -- *(unsigned char *)($ng_cb + 0x14)
expression --allow-jit false -f x -- *(unsigned int *)($ng_cb + 0x18)
expression --allow-jit false -f x -- *(unsigned int *)($ng_cb + 0x1c)
expression --allow-jit false -f x -- *(unsigned char *)($ng_task + 0x2b)
expression --allow-jit false -f x -- *(unsigned int *)($ng_task + 0x30)
expression --allow-jit false -f x -- *(unsigned int *)($ng_task + 0x34)
expression --allow-jit false -f x -- *(unsigned int *)($ng_task + 0x40)
expression --allow-jit false -f x -- *(unsigned int *)($ng_task + 0x78)
breakpoint enable ng_release ng_selected_wake ng_wait_release
continue
DONE

# After the actual object is identified, release can originate on either CPU.
breakpoint set -H -o true -d -a 0x1010ffd8 -N ng_release -c '$ng_cb != 0 && $r0 == $ng_id'
breakpoint command add -s command -e true
thread info
register read -f x r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 sp lr pc cpsr MPIDR_EL1
memory read -f x -s 4 -c 2 0xb2b415f4
expression --allow-jit false -f x -- *(unsigned int *)($ng_cb + 0x18)
continue
DONE

# Selected waiter before the guest calls its wait-release implementation.
breakpoint set -H -o true -d -a 0x10110138 -N ng_selected_wake -c '$ng_cb != 0 && $r4 == $ng_cb && $r0 == $ng_task'
breakpoint command add -s command -e true
thread info
register read -f x r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 sp lr pc cpsr MPIDR_EL1
memory read -f x -s 4 -c 2 0xb2b415f4
expression --allow-jit false -f x -- *(unsigned int *)($ng_cb + 0x18)
continue
DONE

# Entry only: the guest's write through waiter+40 has NOT happened yet.
breakpoint set -H -o true -d -a 0x10120858 -N ng_wait_release -c '$ng_cb != 0 && $r0 == $ng_task'
breakpoint command add -s command -e true
thread info
register read -f x r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 sp lr pc cpsr MPIDR_EL1
memory read -f x -s 4 -c 2 0xb2b415f4
expression --allow-jit false -f x -- *(unsigned int *)($ng_task + 0x40)
continue
DONE

# Candidate marker is constrained to the already observed slot8/index4 caller.
breakpoint set -H -o true -a 0x103b2306 -N ng_marker -c '$lr == 0x104000c1 && $r4 == 4 && $r6 == 0xb185e020 && ($MPIDR_EL1 & 3) < 2'
breakpoint command add -s command -e true
thread info
register read -f x r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 sp lr pc cpsr MPIDR_EL1
expression --allow-jit false -- $ng_pid = (unsigned int)$MPIDR_EL1 & 3
memory read -f x -s 4 -c 2 0xb2b415f4
expression --allow-jit false -f x -- $ng_task = *(unsigned int *)(0xb2b415f4 + 4 * $ng_pid)
breakpoint enable ng_make_wait ng_mutex_block
continue
DONE

breakpoint list -v
